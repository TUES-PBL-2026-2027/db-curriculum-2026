# Copy this file to `.env` and adjust as needed.  Do NOT commit the real .env.
#
#   cp .env.example .env

# Superuser name and password for the PostgreSQL instance.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database created automatically on first boot.
POSTGRES_DB=storefront

# Host port to expose Postgres on. Change if 5432 is already taken on your machine
# (e.g. 5433). The container always listens on 5432 internally.
POSTGRES_PORT=5432
